// Copy this file to secrets.h and fill in your network:
//
//     cp include/secrets.h.example include/secrets.h
//
// secrets.h is gitignored, so nothing here is ever committed.  It is also
// optional -- the build uses __has_include, so a clone without it compiles
// fine and the board opens a setup portal instead: join the "frank-setup"
// network from a phone and pick your WiFi there.
//
// These are only DEFAULTS.  A network configured through the portal is stored
// on the device and takes precedence, so a prop reconfigured somewhere else
// stays reconfigured.
//
// Why a header rather than secrets.ini and build_flags, which would be the
// more idiomatic PlatformIO route: build_flags are processed by SCons, which
// uses '$' as its own substitution character.  A password containing '$' gets
// silently truncated at that point -- not an error, just a shorter string and
// a device that will not associate.  Doubling the '$' does not help.  The
// preprocessor reads this file directly, so the only escaping that applies is
// ordinary C string escaping.

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID "YourNetworkName"
#define WIFI_PASS "YourPassword"

// ---------------------------------------------------------------------------
// Everything below is optional.  Leave it out and the board behaves as it
// always has: no password on over-the-air updates, and a web interface
// anything on the network can drive.  That is a reasonable choice for a prop
// on a home LAN, and it is the default precisely so nobody has to care.
// ---------------------------------------------------------------------------

// Over-the-air updates.  Defining this is all it takes -- there is no switch
// to forget, because a password you meant to use and a flag you did not set
// is a failure mode with no upside.
//
// Worth doing even if you skip the rest: without it, anything on your network
// can flash whatever firmware it likes onto the board.
//
// #define OTA_PASSWORD "choose-something"

// The web interface and the REST API.  Needed when building with -DAUTH_HTTP=1,
// and the build fails rather than shipping a blank password if they are
// missing.  Digest authentication, so the password is never sent in the clear
// -- which matters here, because this device cannot practically serve HTTPS.
//
// #define AUTH_USER "frank"
// #define AUTH_PASS "choose-something"

// An alternative credential for scripts, for -DAUTH_TOKEN=1.  Digest is
// awkward from curl; a bearer token is not:
//
//     curl -H "Authorization: Bearer ..." http://frank.local/api/v1/state
//
// Unlike the password above this one IS sent in the clear on every request,
// so it is the weaker of the two.  Make it long and random.
//
// #define AUTH_TOKEN_VALUE "a-long-random-string"

#endif // SECRETS_H
