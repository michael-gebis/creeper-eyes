.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Real credentials -- see include/secrets.h.example
include/secrets.h

# Python bytecode from the tools
__pycache__/
*.pyc

# KiCad's own scratch: per-user view state, backups, the fab files that
# hardware/make_outputs.py regenerates.  The zip it produces is kept, so a
# board can be ordered from a clone without installing KiCad.
hardware/**/*.kicad_prl
hardware/**/*-backups/
hardware/**/_autosave-*
hardware/**/*.lck
hardware/**/fp-info-cache
hardware/**/3DxService.log
hardware/*/gerbers/*
!hardware/*/gerbers/*-gerbers.zip

# NVS backups: the WiFi password in clear text.  The raw partition image
# carries it whether or not the decoded view shows it.
/backups/
*-nvs-*.json
