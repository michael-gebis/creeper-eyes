	(text "Two Waveshare 1.5\" OLED panels on one SPI bus, chip selects D15 (Frank's right) and D4 (his left);" (exclude_from_sim no) (at 20.32 25.4 0)
		(effects (font (size 1.5 1.5)) (justify left))
		(uuid "0ea8047f-eb63-4f9b-b164-f4859ad8b176")
	)
	(text "an optional DS3231 on the default I2C pins.  Wiring per docs/WIRING.md and docs/WIRING_RTC.md." (exclude_from_sim no) (at 20.32 29.21 0)
		(effects (font (size 1.5 1.5)) (justify left))
		(uuid "647e2779-fe1e-4bd8-a564-6ad125fa7f5f")
	)
	(text "Both panels and the RTC are powered from the DevKit's 3V3 pin, never VIN." (exclude_from_sim no) (at 20.32 33.02 0)
		(effects (font (size 1.5 1.5)) (justify left))
		(uuid "a80b41c7-839f-4a1d-ad8f-0570198605ec")
	)
